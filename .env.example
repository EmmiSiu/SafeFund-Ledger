# --- Configuración Básica ---
PROJECT_NAME="SafeFund Ledger"
ENVIRONMENT=development
DEBUG=True

# --- Seguridad ---
# Genera una clave segura con: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here_change_me

# --- Persistencia ---
# Localización de la base de datos SQLite
DATABASE_URL=sqlite:///./data/safefund.db

# --- Rutas de Archivos ---
# Directorio para los reportes generados
REPORTS_DIR=./data/reports
# Ruta para logs del sistema
LOG_FILE=./data/app.log

# --- Parámetros de la Caja (Defaults iniciales) ---
DEFAULT_INTEREST_INTERNAL=0.05
DEFAULT_INTEREST_EXTERNAL=0.08
TOTAL_QUINCENAS=24