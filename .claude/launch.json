{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "safefund-dev",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "port": 8010
    },
    {
      "name": "safefund-docker",
      "url": "http://localhost:8000"
    },
    {
      "name": "safefund-sandbox",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "-c",
        "import os; os.environ['DATABASE_URL']='sqlite:///./data/sandbox.db'; import uvicorn; uvicorn.run('app.main:app', host='127.0.0.1', port=8011)"
      ],
      "port": 8011
    }
  ]
}